#!/bin/sh
# Base su owns authentication; mdo executes the selected root-owned command.
set -eu
umask 077
[ "$#" -ge 1 ] || exit 2
case $1 in
wifi | bluetooth | wireguard | device | performance | packages | maintenance)
    helper=/usr/local/libexec/nostromo-$1
    ;;
mixer) helper=/usr/sbin/mixer ;;
shutdown) helper=/sbin/shutdown ;;
*) exit 2 ;;
esac
shift
command='exec /usr/bin/mdo -u root -- /usr/bin/env -i HOME=/root USER=root LOGNAME=root PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin LC_ALL=C'
for argument in "$helper" "$@"; do
    # Reject control characters; quote each argument without evaluating its contents.
    case $argument in *[[:cntrl:]]*) exit 2 ;; esac
    quoted=$(printf '%s' "$argument" | sed "s/'/'\\\\''/g")
    command="$command '$quoted'"
done
# Reserve the terminal for PAM. Restore the command streams only after login,
# so a captured catalog/output never captures the root password prompt.
command="$command <&3 >&4 3<&- 4>&-"
# -m uses the configured oksh without login files; the environment starts clean.
if [ -t 2 ]; then
    exec /usr/bin/env -i HOME=/root PATH=/usr/bin:/bin TERM="${TERM:-xterm-256color}" \
        /usr/bin/su -fm root -c "$command" 3<&0 4>&1 </dev/tty >/dev/tty
fi
[ -n "${WAYLAND_DISPLAY:-}" ] || {
    echo 'Administrative changes require a terminal or the Wayland session.' >&2
    exit 1
}
work=$(mktemp -d "${XDG_RUNTIME_DIR:?}/nostromo-admin.XXXXXXXX")
reader='' writer='' terminal=''
cleanup() {
    trap - 0
    for child in "$reader" "$writer" "$terminal"; do
        [ -z "$child" ] || kill "$child" 2>/dev/null || :
    done
    wait || :
    rm -f "$work/input" "$work/output"
    rmdir "$work"
}
trap cleanup 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM
# FIFOs carry the existing streams. Wi-Fi passwords/PINs never go in files or argv.
mkfifo "$work/input" "$work/output"
exec 3<&0
cat <&3 >"$work/input" &
writer=$!
exec 3<&-
cat "$work/output" &
reader=$!
# The child shell expands its own positional arguments after foot creates a TTY.
# shellcheck disable=SC2016
foot --app-id=nostromo.foot --title='Authenticate administrative change' \
    -e /bin/sh -c '
        exec /usr/bin/env -i HOME=/root PATH=/usr/bin:/bin TERM=xterm-256color \
            /usr/bin/su -fm root -c "$1" 3<"$2/input" 4>"$2/output" </dev/tty >/dev/tty
    ' nostromo-admin "$command" "$work" </dev/null &
terminal=$!
result=0
wait "$terminal" || result=$?
terminal=
# Authentication failure can leave the input writer blocked: cleanup cancels it.
if [ "$result" = 0 ]; then
    wait "$reader" || result=$?
    reader=
fi
cleanup
exit "$result"
