#!/bin/sh
set -eu
store=${PASSWORD_STORE_DIR:-$HOME/.password-store}
if [ ! -d "$store" ]; then
    exec less "$HOME/.local/share/nostromo/PASSWORDS.md"
fi
cd "$store"
# List entry names only. Never decrypt a preview or feed secrets to a menu.
entry=$(find . -type f -name '*.gpg' -print | sed 's,^./,,; s,\.gpg$,,' | LC_ALL=C sort | fzf --prompt='PASSWORD > ') || exit 0
[ -n "$entry" ] || exit 0
exec tpass show --clip -- "$entry"
