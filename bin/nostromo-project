#!/bin/sh
set -eu
if [ "$#" -gt 1 ]; then
    echo 'Usage: nostromo-project [directory|--sessions]' >&2
    exit 2
fi
if [ -n "${ABDUCO_SESSION:-}" ]; then
    printf '%s\n' 'Detach with Ctrl+\ before switching abduco sessions.' >&2
    exit 1
fi
state=${XDG_STATE_HOME:-$HOME/.local/state}/nostromo/projects
tab=$(printf '\t')
sessions() { abduco | awk '$NF ~ /^project-[0-9]+$/ {print $NF}'; }
if [ "${1:-}" = --sessions ]; then
    picked=$(sessions | while IFS= read -r session; do
        directory=$(cat "$state/$session" 2>/dev/null || printf '%s' "$session")
        printf '%s\t%s\n' "$directory" "$session"
    done | fzf --prompt='SESSION > ') || exit 0
    [ -n "$picked" ] || exit 0
    name=${picked##*"$tab"}
    case $name in project-*) ;; *) exit 1 ;; esac
    exec abduco -a "$name"
fi
if [ "$#" = 1 ]; then
    directory=$1
else
    directory=$({
        # Projects with a running session come first: Enter reattaches.
        sessions | while IFS= read -r session; do cat "$state/$session" 2>/dev/null || :; done
        sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' "$HOME/.config/nostromo/projects"
        command -v zoxide >/dev/null && zoxide query --list || :
        for project in "$HOME/Projects"/*; do
            [ ! -d "$project" ] || printf '%s\n' "$project"
        done
    } | awk '!seen[$0]++' | fzf --prompt='PROJECT > ') || exit 0
fi
[ -d "$directory" ] || {
    echo "Not a directory: $directory" >&2
    exit 1
}
cd "$directory"
directory=$(pwd -P)
# A digest avoids session collisions for projects with the same basename.
name=$(printf '%s' "$directory" | cksum | awk '{print "project-"$1}')
case $directory in *'
'* | *"$tab"*)
    echo 'Project paths cannot contain tabs or line breaks.' >&2
    exit 1
    ;;
esac
umask 077
mkdir -p "$state"
printf '%s\n' "$directory" >"$state/$name"
command -v zoxide >/dev/null && zoxide add "$directory" || :
exec abduco -A "$name" nostromo-mux
