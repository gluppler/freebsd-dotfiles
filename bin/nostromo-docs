#!/bin/sh
set -eu
reference=${NOSTROMO_DOCS_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/nostromo/reference}
cppreference=${NOSTROMO_CPPREFERENCE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/nostromo/cppreference}
library=${NOSTROMO_LIBRARY_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/nostromo/library}
# Guides, the Secret Knowledge chapters, the electronics guide and saved manuals
# sit beside the examples.
data=${reference%/reference}
knowledge=$data/secret-knowledge
electronics=$data/electronics
manuals=$data/manuals
export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off
gui=no
tmp=
trap '[ -z "$tmp" ] || rm -rf "$tmp"' 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM

choose() {
    if [ "$gui" = yes ]; then
        nostromo-picker -i -l 12 -p "$1"
    else fzf --prompt="$1 > "; fi
}
ask() {
    if [ "$gui" = yes ]; then
        nostromo-picker --input -p "$1"
    else
        printf '%s > ' "$1" >&2
        IFS= read -r answer
        printf '%s\n' "$answer"
    fi
}
tell() {
    if [ "$gui" = yes ]; then
        notify-send 'DOCS' "$1"
    else printf '%s\n' "$1" >&2; fi
}
package_file() {
    files=$(pkg query '%Fp' "$1") || return
    path=$(printf '%s\n' "$files" | awk -v suffix="$2" '
        length($0) >= length(suffix) && substr($0, length($0)-length(suffix)+1) == suffix {print; exit}')
    [ -n "$path" ] && [ -r "$path" ] || {
        printf 'Missing local document from %s: %s\n' "$1" "$2" >&2
        return 1
    }
    printf '%s\n' "$path"
}
rust_file() {
    sysroot=$(rustc --print sysroot) || return
    path=$sysroot/share/doc/rust/html/$1/index.html
    [ -r "$path" ] || {
        echo 'Rust documentation is missing for this toolchain. See OFFLINE-DOCS.md.' >&2
        return 1
    }
    printf '%s\n' "$path"
}
# FreeBSD's LLVM ports move each manual into the shared tree under a versioned
# name: /usr/local/llvm21/bin/llvm-mc is documented by llvm-mc21(1).
llvm_manual() {
    tool=$(nostromo-tool --path llvm-mc) || return
    directory=${tool%/bin/*}
    name=llvm-mc
    case $directory in /usr/local/llvm[0-9]*) name=llvm-mc${directory#/usr/local/llvm} ;; esac
    MANPATH="$directory/share/man${MANPATH:+:$MANPATH}:" man "$@" "$name"
}
rust_topics() {
    for topic in book reference rust-by-example embedded-book std core alloc cargo rustc rustdoc \
        clippy nomicon edition-guide style-guide unstable-book; do
        if rust_file "$topic" >/dev/null 2>&1; then printf '%s\n' "$topic"; fi
    done
}
python_books() { printf '%s\n' tutorial reference library c-api extending howto using faq whatsnew; }
go_document() {
    root=$(go env GOROOT) || return
    case $1 in
    spec) printf '%s\n' "$root/doc/go_spec.html" ;;
    memory-model) printf '%s\n' "$root/doc/go_mem.html" ;;
    assembler) printf '%s\n' "$root/doc/asm.html" ;;
    godebug) printf '%s\n' "$root/doc/godebug.md" ;;
    *) return 2 ;;
    esac
}
go_topics() {
    go help | awk '/^(The commands are|Additional help topics):$/ {list = 1; next} list && /^\t[a-z]/ {print $1}'
}
cmake_topics() {
    printf '%s\n' cmake ctest cpack ccmake cmake-language cmake-commands cmake-variables cmake-properties \
        cmake-modules cmake-generator-expressions cmake-buildsystem cmake-toolchains cmake-presets \
        cmake-packages cmake-policies cmake-generators cmake-compile-features cmake-cxxmodules \
        cmake-env-variables cmake-file-api cpack-generators
}
