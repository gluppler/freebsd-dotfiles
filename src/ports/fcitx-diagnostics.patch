--- a/textproc/fcitx5/files/fcitx5-diagnose
+++ b/textproc/fcitx5/files/fcitx5-diagnose
@@ -0,0 +1,9 @@
+#!/bin/sh
+# Native Wayland diagnostics; no GNU gettext or Bash utility at runtime.
+set -eu
+printf 'Wayland display: %s\nRuntime directory: %s\n' "${WAYLAND_DISPLAY:-unset}" "${XDG_RUNTIME_DIR:-unset}"
+printf 'Fcitx version: '; fcitx5 --version
+printf 'Active engine: '; fcitx5-remote -n
+printf 'Input state (0=unavailable, 1=inactive, 2=active): '; fcitx5-remote
+printf 'Native environment: GTK_IM_MODULE=%s QT_IM_MODULE=%s\n' "${GTK_IM_MODULE:-Wayland protocol}" "${QT_IM_MODULE:-Wayland protocol}"
+printf 'Use nostromo-language menu for English/Japanese/Korean selection.\n'
