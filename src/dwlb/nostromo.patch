+/* A single bottom-left cut; status strings never pass through this painter. */
+static void
+nostromo_tag(pixman_image_t *image, uint32_t from, uint32_t to,
+    uint32_t height, bool active, uint32_t scale)
+{
+    int margin = (int)(2 * scale), thickness = (int)scale;
+    int left = (int)from + margin, right = (int)to - margin;
+    int top = margin, bottom = (int)height - margin;
+    int cut = MAX(1, (bottom - top) / 3);
+    pixman_color_t white = HEX_COLOR(0xffffffff), black = HEX_COLOR(0x000000ff);
+    for (int row = top; row < bottom; row++) {
+        int edge = left + MAX(0, row - (bottom - cut));
+        if (right <= edge) continue;
+        pixman_box32_t outer = {edge, row, right, row + 1};
+        pixman_image_fill_boxes(PIXMAN_OP_SRC, image, &white, 1, &outer);
+        if (!active && row >= top + thickness && row < bottom - thickness && right - edge > 2 * thickness) {
+            pixman_box32_t inner = {edge + thickness, row, right - thickness, row + 1};
+            pixman_image_fill_boxes(PIXMAN_OP_SRC, image, &black, 1, &inner);
+        }
+    }
+}
