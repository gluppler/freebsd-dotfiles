 static void daemonize(void) {
+	/* Block acknowledgement before either child can send it. */
+	sigset_t set, previous;
+	sigemptyset(&set);
+	sigaddset(&set, SIGUSR2);
+	if (sigprocmask(SIG_BLOCK, &set, &previous) == -1)
+		report_error_and_exit("Cannot block lock acknowledgement\n");
 	parent = getpid();
 	pid_t pid = fork();
 	if(pid == -1) report_error_and_exit("Failed to daemonize!\n");
