+// Accept authenticated GnuPG OCB packets as well as standard MDC/AEAD messages.
+// Unauthenticated legacy SED stays disabled. Fully read and verify before returning
+// any plaintext, including trailing authentication tags and compressed content.
+fn decrypt_pass_entry(key_data: &[u8], ciphertext: &[u8], passphrase: &str)
+    -> Result<Zeroizing<Vec<u8>>>
+{
+    let result = (|| -> Result<Zeroizing<Vec<u8>>> {
+        let (key, _) = SignedSecretKey::from_reader_single(Cursor::new(key_data))?;
+        let message = match Message::from_armor(Cursor::new(ciphertext)) {
+            Ok((message, _)) => message,
+            Err(_) => Message::from_bytes(ciphertext)?,
+        };
+        let password = Password::from(passphrase);
+        let ring = TheRing {
+            secret_keys: vec![&key], key_passwords: vec![&password],
+            decrypt_options: DecryptionOptions::new().enable_gnupg_aead(),
+            ..Default::default()
+        };
+        let (message, _) = message.decrypt_the_ring(ring, true)?;
+        let mut message = if message.is_compressed() { message.decompress()? } else { message };
+        let mut plaintext = Zeroizing::new(Vec::new());
+        std::io::Read::read_to_end(&mut message, &mut plaintext)?;
+        Ok(plaintext)
+    })();
+    result.map_err(|_| anyhow::anyhow!("Decryption failed"))
 }
 
