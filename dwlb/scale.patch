 static void
+nostromo_font(Bar *bar)
+{
+    char attrs[32];
+    snprintf(attrs, sizeof(attrs), "dpi=%u", 96 * bar->scale);
+    struct fcft_font *replacement = fcft_from_name(1, (const char *[]){fontstr}, attrs);
+    if (!replacement) DIE("Could not load per-output font");
+    if (bar->font) fcft_destroy(bar->font);
+    bar->font = replacement;
+    bar->textpadding = replacement->height / 2;
+    bar->height = replacement->height + 2 * vertical_padding * bar->scale;
+}
+
+static void
+nostromo_output_geometry(void *data, struct wl_output *output, int32_t x, int32_t y,
+    int32_t width, int32_t height, int32_t subpixel, const char *make,
+    const char *model, int32_t transform) {}
+static void
+nostromo_output_mode(void *data, struct wl_output *output, uint32_t flags,
+    int32_t width, int32_t height, int32_t refresh) {}
+static void
+nostromo_output_done(void *data, struct wl_output *output) {}
+static void
+nostromo_output_scale(void *data, struct wl_output *output, int32_t factor)
+{
+    Bar *bar = data;
+    if (factor < 1 || factor > 16 || bar->scale == (uint32_t)factor) return;
+    bar->scale = factor;
+    if (!bar->font) return; /* Registry enumeration precedes fcft initialization. */
+    nostromo_font(bar);
+    if (!bar->hidden) {
+        bar->configured = false;
+        zwlr_layer_surface_v1_set_size(bar->layer_surface, 0, bar->height / bar->scale);
+        zwlr_layer_surface_v1_set_exclusive_zone(bar->layer_surface, bar->height / bar->scale);
+        wl_surface_commit(bar->wl_surface);
+    }
+}
+static const struct wl_output_listener nostromo_output_listener = {
+    .geometry = nostromo_output_geometry, .mode = nostromo_output_mode,
+    .done = nostromo_output_done, .scale = nostromo_output_scale,
+};
