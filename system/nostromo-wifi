#!/bin/sh
# Root-owned FreeBSD net80211 workflow; secrets enter on stdin only.
set -eu
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
LC_ALL=C
export PATH LC_ALL
umask 077
# Installed awk programs; the console bootstrap passes the checkout's copies.
share=${NOSTROMO_WIFI_SHARE:-/usr/local/share/nostromo}
[ "$(uname -s)" = FreeBSD ] && [ "$(id -u)" = 0 ] || exit 1
[ "$#" = 2 ] || exit 2
action=$1
interface=$2
case $interface in '' | *[!a-zA-Z0-9]*) exit 2 ;; esac
ifconfig -g wlan | tr ' ' '\n' | grep -Fxq -e "$interface" || exit 2
file=$(sysrc -n wpa_supplicant_conf_file)
case $file in /etc/*) ;; *)
    echo 'Review the custom supplicant file outside /etc before using this menu.' >&2
    exit 1
    ;;
esac
[ -f "$file" ] && [ ! -L "$file" ] && [ "$(stat -f '%u %Lp' "$file")" = '0 600' ] || {
    echo 'The WPA configuration must be a regular root-owned file with mode 600.' >&2
    exit 1
}
parent=${file%/*}
while [ "$parent" != / ]; do
    [ -d "$parent" ] && [ ! -L "$parent" ] && [ "$(stat -f '%u' "$parent")" = 0 ] || exit 1
    mode=$(stat -f '%Lp' "$parent")
    [ "$((0$mode & 0022))" = 0 ] || {
        echo 'Writable WPA configuration parent.' >&2
        exit 1
    }
    parent=${parent%/*}
    [ -n "$parent" ] || parent=/
done
control_path=$(awk -F= '/^[ \t]*ctrl_interface=/{v=$2} END {print v}' "$file")
case $control_path in /var/run/*) ;; *)
    echo 'Set ctrl_interface=/var/run/wpa_supplicant in the WPA configuration first.' >&2
    exit 1
    ;;
esac
case $control_path in *[!a-zA-Z0-9_./-]*) exit 1 ;; esac
wpa() { wpa_cli -p "$control_path" -i "$interface" "$@"; }
ready() {
    attempt=0
    while [ "$attempt" -lt 10 ]; do
        if wpa ping 2>/dev/null | grep -q '^PONG$'; then return; fi
        sleep 1
        attempt=$((attempt + 1))
    done
    return 1
}
associated() {
    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if wpa status | awk -F= -v wanted="$1" '
            $1=="id" {id=$2} $1=="wpa_state" {state=$2}
            END {exit !(id==wanted && state=="COMPLETED")}'; then return; fi
        sleep 1
        attempt=$((attempt + 1))
    done
    echo 'Association timed out; check the credentials and device support.' >&2
    return 1
}
# The security modes the running supplicant can use with this driver.
modes() {
    capabilities=$(wpa get_capability key_mgmt) || return 1
    for pair in wpa2:WPA-PSK wpa3:SAE open:NONE owe:OWE; do
        if printf '%s\n' "$capabilities" | tr ' ' '\n' | grep -Fxq -e "${pair#*:}"; then
            printf '%s\n' "${pair%:*}"
        fi
    done
}
case $action in
status) exec wpa_cli -p "$control_path" -i "$interface" status ;;
modes)
    modes
    exit
    ;;
scan)
    wpa scan | grep -q '^OK$' || exit 1
    sleep 3
    exec wpa_cli -p "$control_path" -i "$interface" scan_results
    ;;
saved) exec wpa_cli -p "$control_path" -i "$interface" list_networks ;;
disconnect)
    wpa disconnect | grep -q '^OK$'
    exit
    ;;
reconnect)
    wpa reconnect | grep -q '^OK$'
    exit
    ;;
select)
    IFS= read -r id
    case $id in '' | *[!0-9]*) exit 2 ;; esac
    wpa list_networks | awk -F '\t' -v id="$id" '$1==id {ok=1} END {exit !ok}' || exit 2
    ;;
connect) ;;
*) exit 2 ;;
esac
if [ "$action" = connect ]; then
    IFS= read -r ssid
    IFS= read -r security
    IFS= read -r secret
    case $ssid in '' | *[!0-9a-f]*) exit 2 ;; esac
    [ "${#ssid}" -le 64 ] && [ "$((${#ssid} % 2))" = 0 ] || exit 2
    case $security in wpa2 | wpa3 | open | owe) ;; *) exit 2 ;; esac
    case $secret in *[[:cntrl:]]*) exit 2 ;; esac
    if [ "$security" = wpa2 ] || [ "$security" = wpa3 ]; then
        [ "${#secret}" -ge 8 ] && [ "${#secret}" -le 63 ] || {
            echo 'Use an 8–63 byte personal-network passphrase.' >&2
            exit 2
        }
    fi
    available=$(modes) || exit 1
    printf '%s\n' "$available" | grep -Fxq -e "$security" || {
        printf '%s is not available with this Wi-Fi driver and supplicant. Available: %s.\n' \
            "$security" "$(printf '%s\n' "$available" | paste -sd ' ' -)" >&2
        exit 1
    }
fi
lock=/var/run/nostromo-wifi.$interface.lock
mkdir "$lock" || {
    echo 'Another Wi-Fi change is in progress.' >&2
    exit 1
}
changed=no
selected=no
before_id=$(wpa status | awk -F= '$1=="id"{print $2}')
dhcp=no
case " $(sysrc -n "ifconfig_$interface") " in *' DHCP '* | *' SYNCDHCP '*) dhcp=yes ;; esac
replace_file() {
    temporary=$(mktemp "${file}.nostromo.XXXXXXXX") || return 1
    if install -m 600 "$1" "$temporary" && mv "$temporary" "$file"; then return 0; fi
    rm -f "$temporary"
    return 1
}
finish() {
    result=$?
    trap - 0
    if [ "$changed" = yes ]; then
        if replace_file "$lock/before"; then
            service wpa_supplicant onerestart "$interface" || :
            ready || :
        else
            echo "Restoration failed. The previous WPA configuration is in $lock/before." >&2
            exit 1
        fi
        echo 'Wi-Fi change failed; restored the previous saved configuration.' >&2
    fi
    if [ "$changed" = yes ] || [ "$selected" = yes ]; then
        case $before_id in
        '' | *[!0-9]*) wpa disconnect >/dev/null || : ;;
        *) wpa select_network "$before_id" >/dev/null && associated "$before_id" || : ;;
        esac
        [ "$dhcp" = no ] || service dhclient onerestart "$interface" || :
    fi
    rm -f "$lock/before" "$lock/kept" "$lock/block" "$lock/candidate"
    rmdir "$lock"
    unset secret escaped
    exit "$result"
}
trap finish 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM
if [ "$action" = select ]; then
    selected=yes
    wpa select_network "$id" | grep -q '^OK$'
    associated "$id"
    [ "$dhcp" = no ] || service dhclient onerestart "$interface"
    selected=no
    wpa status
    exit
fi
cp -p "$file" "$lock/before"
# The new profile replaces every saved one for this network name, whoever wrote it.
replaced=no
if awk -v ssid="$ssid" -v mode=find -f "$share/forget-network.awk" "$lock/before"; then replaced=yes; fi
awk -v ssid="$ssid" -f "$share/forget-network.awk" "$lock/before" >"$lock/kept" || {
    echo 'The WPA configuration has a network name wpa_supplicant cannot read; review it first.' >&2
    exit 1
}
escaped=$(printf '%s' "$secret" | sed 's/\\/\\\\/g; s/"/\\"/g')
{
    printf 'network={\n ssid=%s\n id_str="nostromo-%s"\n scan_ssid=1\n' "$ssid" "$ssid"
    case $security in
    open) printf ' key_mgmt=NONE\n' ;;
    owe) printf ' key_mgmt=OWE\n ieee80211w=2\n owe_only=1\n' ;;
    wpa2) printf ' key_mgmt=WPA-PSK\n proto=RSN\n psk="%s"\n' "$escaped" ;;
    wpa3) printf ' key_mgmt=SAE\n ieee80211w=2\n sae_password="%s"\n' "$escaped" ;;
    esac
    printf '}\n'
} >"$lock/block"
unset secret escaped
awk -v name="WIFI $ssid" -v replacement="$lock/block" -f "$share/merge-block.awk" "$lock/kept" >"$lock/candidate"
changed=yes
replace_file "$lock/candidate"
service wpa_supplicant onerestart "$interface"
ready
# The supplicant's own reading must agree: only the new profile names this network.
id='' others=0
for candidate in $(wpa list_networks | awk -F '\t' '$1 ~ /^[0-9]+$/ {print $1}'); do
    if [ "$(wpa get_network "$candidate" id_str)" = "\"nostromo-$ssid\"" ]; then
        id=$candidate
        continue
    fi
    # get_network quotes a printable name and writes any other in hex.
    name=$(wpa get_network "$candidate" ssid)
    case $name in \"*\")
        name=${name#\"}
        name=$(printf '%s' "${name%\"}" | od -An -v -tx1 | tr -d ' \n')
        ;;
    esac
    [ "$name" != "$ssid" ] || others=$((others + 1))
done
[ -n "$id" ] || {
    echo 'The supplicant rejected the new profile.' >&2
    exit 1
}
[ "$others" = 0 ] || {
    echo 'Another saved profile still names this network; review the WPA configuration.' >&2
    exit 1
}
wpa select_network "$id" | grep -q '^OK$'
associated "$id"
if [ "$dhcp" = yes ]; then service dhclient onerestart "$interface"; fi
changed=no
printf 'Associated and saved. DHCP/DNS/reachability are separate from wireless authentication.\n'
[ "$replaced" = no ] || printf 'The new profile replaced the one saved earlier for this network.\n'
printf 'For a public network with web sign-in, choose PORTAL in the Wi-Fi menu.\n'
wpa status
