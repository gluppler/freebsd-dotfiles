#!/bin/sh
# Native wg(4), typed network settings and owned routes; no shell hooks or DNS rewrite.
set -eu
PATH=/bin:/sbin:/usr/bin:/usr/sbin:/usr/local/bin:/usr/local/sbin
LC_ALL=C
export PATH LC_ALL
umask 077
[ "$(uname -s)" = FreeBSD ] && [ "$(id -u)" = 0 ] || exit 1
[ "$#" = 2 ] || exit 2
action=$1
interface=$2
case $interface in wg[0-9]*) ;; *) exit 2 ;; esac
case ${interface#wg} in *[!0-9]*) exit 2 ;; esac
wg=/usr/local/libexec/nostromo-wg
case $action in
brief | status)
    if ! ifconfig "$interface" >/dev/null 2>&1; then
        echo OFF
        exit
    fi
    if ! ifconfig "$interface" | head -n 1 | grep -q '<UP[,>]'; then
        echo DOWN
        exit
    fi
    if [ "$action" = status ]; then
        ifconfig "$interface"
        "$wg" show "$interface" latest-handshakes
        "$wg" show "$interface" transfer
        echo 'Handshake age and traffic are observations, not a reachability guarantee.'
    else
        handshakes=$("$wg" show "$interface" latest-handshakes) || exit 1
        printf '%s\n' "$handshakes" | awk -v now="$(date +%s)" '
                $2 ~ /^[0-9]+$/ {peers++; if($2>latest)latest=$2}
                END {if(!peers)print "NO-PEER";else if(!latest)print "NEW";
                     else if(now-latest<=180 && now>=latest)print "RECENT";else print "IDLE"}'
    fi
    exit
    ;;
up | down | profiles) ;;
*) exit 2 ;;
esac
directory=/usr/local/etc/nostromo/wireguard
state=/var/run/nostromo-wireguard
for parent in /usr/local /usr/local/etc /usr/local/etc/nostromo "$directory"; do
    [ -d "$parent" ] && [ ! -L "$parent" ] && [ "$(stat -f '%u' "$parent")" = 0 ] || exit 1
    case $(stat -f '%Lp' "$parent") in *[2367][0-7] | *[0-7][2367])
        echo 'Writable WireGuard parent directory.' >&2
        exit 1
        ;;
    esac
done
if [ "$action" = profiles ]; then
    for profile in "$directory"/wg*.conf; do
        name=${profile##*/}
        name=${name%.conf}
        case ${name#wg} in '' | *[!0-9]*) continue ;; esac
        valid=yes
        for candidate in "$profile" "$directory/$name.network"; do
            if [ ! -f "$candidate" ] || [ -L "$candidate" ] || [ "$(stat -f '%u %Lp' "$candidate")" != '0 600' ]; then valid=no; fi
        done
        [ "$valid" != yes ] || printf '%s\n' "$name"
    done
    exit
fi
[ ! -L "$state" ] || exit 1
mkdir -p "$state"
[ "$(stat -f '%u %Lp' "$state")" = '0 700' ] || exit 1
lock=$state/$interface.lock
mkdir "$lock" || {
    echo 'A WireGuard operation is already running.' >&2
    exit 1
}
created=no
routes=$state/$interface.routes
finish() {
    result=$?
    trap - 0
    if [ "$created" = yes ]; then
        if [ -f "$routes" ]; then
            while read -r family network; do
                case $family in inet | inet6) route -q delete "-$family" -net "$network" -interface "$interface" || : ;; esac
            done <"$routes"
        fi
        ifconfig "$interface" destroy || :
        rm -f "$routes"
    fi
    rmdir "$lock"
    exit "$result"
}
trap finish 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM
if [ "$action" = down ]; then
    [ -f "$routes" ] && [ ! -L "$routes" ] && [ "$(stat -f '%u %Lp' "$routes")" = '0 600' ] || {
        echo 'Refusing to remove an interface not created by this helper.' >&2
        exit 1
    }
    IFS=' ' read -r marker owner <"$routes"
    [ "$marker" = owner ] || exit 1
    case $owner in nostromo:.*) ;; *) exit 1 ;; esac
    description=$(ifconfig "$interface" | sed -n 's/^[[:space:]]*description: //p')
    [ "$description" = "$owner" ] || {
        echo 'The interface no longer belongs to this saved transaction; inspect it manually.' >&2
        exit 1
    }
    # Interface removal removes its routes, including only this helper's explicit routes.
    ifconfig "$interface" destroy
    rm -f "$routes"
    exit
fi
if ifconfig "$interface" >/dev/null 2>&1; then
    echo 'The interface already exists; bring the managed tunnel down before reconfiguring it.' >&2
    exit 1
fi
[ ! -e "$routes" ] && [ ! -L "$routes" ] || {
    echo 'A previous tunnel journal remains; inspect it before creating another interface.' >&2
    exit 1
}
for file in "$directory/$interface.conf" "$directory/$interface.network"; do
    [ -f "$file" ] && [ ! -L "$file" ] && [ "$(stat -f '%u %Lp' "$file")" = '0 600' ] || {
        echo "Configure a root-owned mode-600 $file first; see WIREGUARD.md." >&2
        exit 1
    }
done
awk '
    /^[ \t]*(#|$)/ {next}
    NF!=3 || $1 !~ /^(address|route)$/ || $2 !~ /^(inet|inet6)$/ {bad=1;next}
    $2=="inet" && $3 !~ /^[0-9.]+\/[0-9]+$/ {bad=1}
    $2=="inet6" && $3 !~ /^[0-9a-fA-F:]+\/[0-9]+$/ {bad=1}
    $3 ~ /\/0$/ {bad=1}
    $1=="address" {addresses++}
    END {exit bad || !addresses}
' "$directory/$interface.network" || {
    echo 'Invalid network file; use explicit split routes, not a default route.' >&2
    exit 2
}
# The description binds the journal to this creation, not merely the reusable name.
journal=$(mktemp "$state/.$interface.XXXXXXXX")
owner=nostromo:${journal##*/}
printf 'owner %s\n' "$owner" >"$journal"
mv "$journal" "$routes"
if ! ifconfig "$interface" create; then
    rm -f "$routes"
    exit 1
fi
created=yes
ifconfig "$interface" description "$owner"
ifconfig "$interface" group nostromo_wg
"$wg" setconf "$interface" "$directory/$interface.conf"
while read -r kind family network; do
    case $kind in '' | \#*) continue ;; esac
    if [ "$kind" = address ]; then ifconfig "$interface" "$family" "$network" alias; fi
done <"$directory/$interface.network"
ifconfig "$interface" up
while read -r kind family network; do
    [ "$kind" = route ] || continue
    # add refuses an existing exact route; never replace unrelated/default routes.
    route -q add "-$family" -net "$network" -interface "$interface"
    printf '%s %s\n' "$family" "$network" >>"$routes"
done <"$directory/$interface.network"
created=no
printf '%s is up; generate traffic to establish a handshake.\n' "$interface"
