--- a/input.c
+++ b/input.c
@@ -206,6 +206,22 @@
     case BIND_ACTION_FONT_SIZE_RESET:
         term_font_size_reset(term);
         return true;
+
+    case BIND_ACTION_ALPHA_UP:
+    case BIND_ACTION_ALPHA_DOWN:
+    case BIND_ACTION_ALPHA_RESET: {
+        /* Background only; text and pane dividers retain their own opacity. */
+        int alpha = action == BIND_ACTION_ALPHA_RESET
+            ? term_theme_get(term)->alpha
+            : term->colors.alpha + (action == BIND_ACTION_ALPHA_UP ? 3277 : -3277);
+        term->colors.alpha = min(65535, max(6554, alpha));
+        wayl_win_alpha_changed(term->window);
+        term_font_subpixel_changed(term);
+        term_damage_view(term);
+        term_damage_margins(term);
+        render_refresh(term);
+        return true;
+    }
 
     case BIND_ACTION_SPAWN_TERMINAL:
         term_spawn_new(term);
