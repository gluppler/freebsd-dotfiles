#!/bin/sh
set -eu
config=${XDG_CONFIG_HOME:-$HOME/.config}/nostromo
# shellcheck source=home/.config/nostromo/services.conf
. "$config/services.conf"
# Optional user overrides are outside this checkout.
# shellcheck source=/dev/null
[ ! -r "$config/services.local" ] || . "$config/services.local"
case $SERVER_HOST in
'' | -* | *[!A-Za-z0-9._@:-]*)
    echo 'Set SERVER_HOST to an SSH alias or user@host in ~/.config/nostromo/services.local.' >&2
    exit 1
    ;;
esac
exec ssh "$SERVER_HOST" "$@"
