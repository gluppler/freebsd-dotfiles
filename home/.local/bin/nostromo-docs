#!/bin/sh
set -eu
reference=${NOSTROMO_DOCS_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/nostromo/reference}
cppreference=${NOSTROMO_CPPREFERENCE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/nostromo/cppreference}
export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off
gui=no
tmp=
trap '[ -z "$tmp" ] || rm -f "$tmp"' 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM

choose() {
    if [ "$gui" = yes ]; then
        nostromo-picker -i -l 12 -p "$1"
    else fzf --prompt="$1 > "; fi
}
ask() {
    if [ "$gui" = yes ]; then
        nostromo-picker --input -p "$1"
    else
        printf '%s > ' "$1" >&2
        IFS= read -r answer
        printf '%s\n' "$answer"
    fi
}
package_file() {
    files=$(pkg query '%Fp' "$1") || return
    path=$(printf '%s\n' "$files" | awk -v suffix="$2" '
        length($0) >= length(suffix) && substr($0, length($0)-length(suffix)+1) == suffix {print; exit}')
    [ -n "$path" ] && [ -r "$path" ] || {
        printf 'Missing local document from %s: %s\n' "$1" "$2" >&2
        return 1
    }
    printf '%s\n' "$path"
}
rust_file() {
    sysroot=$(rustc --print sysroot) || return
    path=$sysroot/share/doc/rust/html/$1/index.html
    [ -r "$path" ] || {
        echo 'Rust documentation is missing for this toolchain. See OFFLINE-DOCS.md.' >&2
        return 1
    }
    printf '%s\n' "$path"
}
# FreeBSD's LLVM ports move each manual into the shared tree under a versioned
# name: /usr/local/llvm21/bin/llvm-mc is documented by llvm-mc21(1).
llvm_manual() {
    tool=$(nostromo-tool --path llvm-mc) || return
    directory=${tool%/bin/*}
    name=llvm-mc
    case $directory in /usr/local/llvm[0-9]*) name=llvm-mc${directory#/usr/local/llvm} ;; esac
    MANPATH="$directory/share/man${MANPATH:+:$MANPATH}:" man "$@" "$name"
}
rust_topics() {
    for topic in book reference rust-by-example embedded-book std core alloc cargo rustc rustdoc \
        clippy nomicon edition-guide style-guide unstable-book; do
        if rust_file "$topic" >/dev/null 2>&1; then printf '%s\n' "$topic"; fi
    done
}
versions() {
    printf 'cppreference HTML snapshot: 2025-02-09 (see OFFLINE-DOCS.md)\n'
    pkg query '%n %v' stdman python-doc-html python-doc-text en-freebsd-doc
    rustc --version
    go version
    python3 --version
    clang --version
}
book() {
    [ -r "$1" ] || {
        echo "Missing local book: $1" >&2
        return 1
    }
    encoded=$(printf '%s' "$1" | LC_ALL=C od -An -v -tx1 |
        awk '{for(i=1;i<=NF;i++) if ($i=="2f") printf "/"; else printf "%%%s",$i}')
    QT_QPA_PLATFORM=wayland qutebrowser --target window -- "file://$encoded"
}
page() {
    tmp=$(mktemp "${TMPDIR:-/tmp}/nostromo-docs.XXXXXXXX")
    "$@" >"$tmp"
    less -iMRS -- "$tmp"
}
markdown() {
    [ -r "$1" ] || {
        echo "Missing example: $1" >&2
        return 1
    }
    columns=$(tput cols 2>/dev/null || printf '80')
    case $columns in '' | *[!0-9]*) columns=80 ;; esac
    [ "$columns" -ge 20 ] || columns=20
    page lowdown -Tterm --term-no-colour --term-hpadding=1 --term-width="$columns" "$1"
}

action=${1:-menu}
if [ "$#" -gt 0 ]; then
    [ "$action" != menu ] || gui=yes
    shift
fi
if [ "$action" = --hold ]; then
    if "$0" "$@"; then exit 0; fi
    printf '\nPress Enter to close. ' >&2
    IFS= read -r answer || :
    exit 1
fi
case $action in menu | --check | llvm | freebsd | versions) [ "$#" = 0 ] || exit 2 ;; esac
if [ "$action" = menu ]; then
    choice=$(printf '%s\n' 'C FUNCTIONS' 'C LANGUAGE' 'C++ LIBRARY' 'C++ LANGUAGE' 'RUST BOOK' 'RUST API' \
        'GO PACKAGES' 'GO LANGUAGE' 'GO EXAMPLES' 'PYTHON LIBRARY' 'PYTHON BOOK' 'EXAMPLE TEMPLATES' \
        'SHELL AND TOOLS' 'LLVM ASSEMBLER' 'FREEBSD HANDBOOK' 'PROJECT GUIDES' 'REFERENCE VERSIONS' |
        choose DOCS) || exit 0
    case $choice in
    'C FUNCTIONS') set -- c "$(ask 'C function, e.g. malloc')" ;;
    'C LANGUAGE') set -- language c ;;
    'C++ LIBRARY') set -- cpp "$(ask 'C++ name, e.g. std::vector')" ;;
    'C++ LANGUAGE') set -- language cpp ;;
    'RUST BOOK')
        topic=$(rust_topics | choose RUST) || exit 0
        set -- rust "$topic"
        ;;
    'RUST API') set -- rust std ;;
    'GO PACKAGES') set -- go "$(ask 'Go package or symbol, e.g. fmt.Printf')" ;;
    'GO LANGUAGE') set -- go-language ;;
    'GO EXAMPLES') set -- go-examples "$(ask 'Go package, e.g. fmt')" ;;
    'PYTHON LIBRARY') set -- python "$(ask 'Python module, e.g. pathlib')" ;;
    'PYTHON BOOK')
        topic=$(printf '%s\n' tutorial reference library c-api extending howto using whatsnew | choose PYTHON) || exit 0
        set -- python-book "$topic"
        ;;
    'EXAMPLE TEMPLATES')
        topic=$(printf '%s\n' c cpp rust go python shell assembly vis zephyr | choose EXAMPLES) || exit 0
        set -- examples "$topic"
        ;;
    'SHELL AND TOOLS')
        topic=$(printf '%s\n' sh oksh make git ssh pf.conf wg vis dvtm foot fuzzel nostromo-docs | choose MANUAL) || exit 0
        set -- man "$topic"
        ;;
    'LLVM ASSEMBLER') set -- llvm ;;
    'FREEBSD HANDBOOK') set -- freebsd ;;
    'REFERENCE VERSIONS') set -- versions ;;
    'PROJECT GUIDES')
        topic=$(printf '%s\n' OFFLINE-DOCS KEYBINDINGS DEVELOPMENT EMBEDDED PACKAGES \
            BASE-SETUP INSTALL FIRST-RUN HARDWARE AUTHENTICATION WIREGUARD WIFI BLUETOOTH PASSWORDS SYSTEM-INFO | choose GUIDE) || exit 0
        set -- guide "$topic"
        ;;
    *) exit 0 ;;
    esac
    [ "$#" != 2 ] || [ -n "$2" ] || exit 0
    if [ "$gui" = yes ]; then
        (
            case $1 in
            rust | freebsd | language | go-language | python-book) "$0" "$@" ;;
            *) foot -e "$0" --hold "$@" ;;
            esac || notify-send 'DOCS' 'Could not open the reference. Run nostromo-docs in a terminal for details.'
        ) </dev/null >/dev/null 2>&1 &
        exit 0
    fi
    action=$1
    shift
fi

if [ "$action" = --check ]; then
    for name in clang rustc cargo git sh oksh make ssh pf.conf wg vis dvtm abduco \
        dwl dwlb foot fuzzel gtklock dunst nnn nostromo-docs; do
        man -w "$name" >/dev/null
    done
    man -w 3 malloc >/dev/null
    man -w 3 'std::vector' >/dev/null
    for topic in book std reference rust-by-example embedded-book; do rust_file "$topic" >/dev/null; done
    llvm_manual -w >/dev/null
    package_file python-doc-text /library/pathlib.txt >/dev/null
    for topic in tutorial reference library c-api extending howto using whatsnew; do
        package_file python-doc-html "/$topic/index.html" >/dev/null
    done
    test -s "$cppreference/en/c.html"
    test -s "$cppreference/en/cpp.html"
    test -s "$(go env GOROOT)/doc/go_spec.html"
    package_file en-freebsd-doc /en/books/handbook/index.html >/dev/null
    for topic in c cpp rust go python shell assembly vis zephyr; do test -s "$reference/$topic.md"; done
    GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off go doc fmt.Printf >/dev/null
    printf 'Offline manuals, examples and language references are available.\n'
    exit
fi
[ "$#" -le 1 ] || {
    echo 'Use nostromo-docs [menu|ACTION [TOPIC]]. See man nostromo-docs.' >&2
    exit 2
}
topic=${1:-}
# Arguments go to man/go or a known reference directory, never to a shell.
case $topic in -* | *[!A-Za-z0-9_:.+/-]* | *'..'* | /*)
    echo 'Invalid documentation topic.' >&2
    exit 2
    ;;
esac
case $action in
c | cpp | man)
    [ -n "$topic" ] || exit 2
    export MANPAGER='less -iMR'
    if [ "$action" = man ]; then exec man "$topic"; else exec man 3 "$topic"; fi
    ;;
examples)
    case $topic in c | cpp | rust | go | python | shell | assembly | vis | zephyr) ;; *) exit 2 ;; esac
    markdown "$reference/$topic.md"
    ;;
rust)
    rust_topics | grep -Fxq -e "$topic" || exit 2
    book "$(rust_file "$topic")"
    ;;
language)
    case $topic in c | cpp) ;; *) exit 2 ;; esac
    book "$cppreference/en/$topic.html"
    ;;
go-language)
    [ -z "$topic" ] || exit 2
    book "$(go env GOROOT)/doc/go_spec.html"
    ;;
python-book)
    case $topic in tutorial | reference | library | c-api | extending | howto | using | whatsnew) ;; *) exit 2 ;; esac
    book "$(package_file python-doc-html "/$topic/index.html")"
    ;;
versions) page versions ;;
go | go-examples)
    [ -n "$topic" ] || exit 2
    export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off
    if [ "$action" = go ]; then
        page go doc -all "$topic"
    else
        directory=$(go list -f '{{.Dir}}' "$topic")
        example=$(for file in "$directory"/*example*_test.go; do
            [ ! -f "$file" ] || printf '%s\n' "$file"
        done | choose EXAMPLE) || exit 0
        [ -f "$example" ] || {
            echo 'No installed example_test.go for this package.' >&2
            exit 1
        }
        less -iMRS -- "$example"
    fi
    ;;
python)
    [ -n "$topic" ] || topic=index
    file=$(package_file python-doc-text "/library/$topic.txt")
    less -iMRS -- "$file"
    ;;
llvm) llvm_manual ;;
freebsd) book "$(package_file en-freebsd-doc /en/books/handbook/index.html)" ;;
guide)
    topic=${topic:-OFFLINE-DOCS}
    case $topic in OFFLINE-DOCS | KEYBINDINGS | DEVELOPMENT | EMBEDDED | PACKAGES | \
        BASE-SETUP | INSTALL | FIRST-RUN | HARDWARE | AUTHENTICATION | WIREGUARD | WIFI | BLUETOOTH | PASSWORDS | SYSTEM-INFO) ;; *) exit 2 ;; esac
    markdown "${reference%/reference}/$topic.md"
    ;;
*)
    echo 'Use nostromo-docs menu, or read man nostromo-docs.' >&2
    exit 2
    ;;
esac
