#!/bin/sh
set -eu
[ "$#" = 0 ] || exit 2
# shellcheck source=home/.local/share/nostromo/network-menu.sh
. "${XDG_DATA_HOME:-$HOME/.local/share}/nostromo/network-menu.sh"
control() { nostromo-admin wifi "$@"; }
trap 'unset secret' 0
trap 'exit 130' INT
trap 'exit 143' HUP TERM
interface=
while :; do
    if [ -z "$interface" ]; then
        interfaces=$(network_capture 'Wi-Fi adapters' ifconfig -g wlan) || exit 1
        interfaces=$(printf '%s\n' "$interfaces" | tr ' ' '\n' | sed '/^$/d')
        interface=$(network_choice 'Wi-Fi adapter' "$interfaces") || exit 0
    fi
    action=$(network_choice "Wi-Fi / $interface" "$(printf '%s\n' SCAN HIDDEN SAVED PORTAL STATUS RECONNECT DISCONNECT ADAPTER EXIT)") || exit 0
    case $action in
    SCAN)
        network_busy Wi-Fi
        result=$(network_capture 'Wi-Fi scan' control scan "$interface") || continue
        rows=$(printf '%s\n' "$result" | awk -F '\t' '$1 ~ /^([0-9a-fA-F][0-9a-fA-F]:){5}[0-9a-fA-F][0-9a-fA-F]$/')
        row=$(network_choice 'Access point / signal / security / SSID' "$rows") || continue
        name=$(printf '%s\n' "$row" | cut -f5-)
        [ -n "$name" ] || {
            network_notice Wi-Fi 'Use HIDDEN to enter this network name.'
            continue
        }
        ssid=$(printf '%s\n' "$name" | LC_ALL=C awk -f /usr/local/share/nostromo/ssid-hex.awk) || continue
        ;;
    HIDDEN)
        name=$(nostromo-picker --input -p 'Network name') || continue
        [ -n "$name" ] || continue
        ssid=$(printf '%s' "$name" | od -An -v -tx1 | tr -d ' \n')
        ;;
    SAVED)
        result=$(network_capture 'Saved networks' control saved "$interface") || continue
        rows=$(printf '%s\n' "$result" | awk -F '\t' '$1 ~ /^[0-9]+$/')
        row=$(network_choice 'Saved network' "$rows") || continue
        network_busy Wi-Fi
        printf '%s\n' "$row" | cut -f1 | network_run 'Wi-Fi selection' control select "$interface"
        continue
        ;;
    PORTAL)
        # An ordinary HTTP page lets the access point redirect to its sign-in page.
        qutebrowser --target window http://neverssl.com/ >/dev/null 2>&1 &
        continue
        ;;
    STATUS | RECONNECT | DISCONNECT)
        operation=$(printf '%s' "$action" | tr '[:upper:]' '[:lower:]')
        network_run "Wi-Fi $operation" control "$operation" "$interface"
        continue
        ;;
    ADAPTER)
        interface=
        continue
        ;;
    EXIT) exit 0 ;;
    *) exit 2 ;;
    esac
    security=$(network_choice 'Network security' "$(printf '%s\n' wpa2 wpa3 open owe)") || continue
    secret=
    if [ "$security" = wpa2 ] || [ "$security" = wpa3 ]; then
        secret=$(nostromo-picker --password -p 'Wi-Fi password') || continue
    fi
    network_busy Wi-Fi
    printf '%s\n' "$ssid" "$security" "$secret" | network_run 'Wi-Fi connect' control connect "$interface"
    unset secret
done
