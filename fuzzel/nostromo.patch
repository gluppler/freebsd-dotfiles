+/* Measure the same shaped glyph advances as render_text(), once per resize/load.
+ * Large catalogs stop at the width cap; input text/passwords never drive sizing. */
+static int
+nostromo_text_width(struct render *render, const char32_t *text, int ceiling)
+{
+    if (!text) return 0;
+    size_t len = 0;
+    while (text[len] && len < 1024) len++;
+    if (!len) return 0;
+    struct fcft_text_run *run = NULL;
+    if (fcft_capabilities() & FCFT_CAPABILITY_TEXT_RUN_SHAPING)
+        run = fcft_rasterize_text_run_utf32(render->font, len, text, render->subpixel);
+    int width = 0, spacing = pt_or_px_as_pixels(render, &render->conf->letter_spacing);
+    const struct fcft_glyph *space = fcft_rasterize_char_utf32(render->font, U' ', render->subpixel);
+    size_t count = run ? run->count : len;
+    for (size_t i = 0; i < count && width < ceiling; i++) {
+        size_t cluster = run ? (size_t)run->cluster[i] : i;
+        const struct fcft_glyph *glyph = run ? run->glyphs[i] :
+            fcft_rasterize_char_utf32(render->font, text[i], render->subpixel);
+        if (text[cluster] == U'\t') {
+            int tabs = render->conf->tabs;
+            if (tabs && space) width += (tabs - cluster % tabs) * space->advance.x;
+        } else if (glyph) {
+            long kern = 0;
+            if (!run && i) fcft_kerning(render->font, text[i-1], text[i], &kern, NULL);
+            width += max(0, glyph->advance.x + spacing + kern);
+        }
+    }
+    fcft_text_run_destroy(run);
+    return min(width, ceiling);
+}
