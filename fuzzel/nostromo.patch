+
+size_t
+render_fit_panel(struct render *render, int available_width, int available_height,
+                 int *width, int *height)
+{
+    int ceiling = max(1, min(720 * render->scale, available_width));
+    const struct fcft_glyph *cell = fcft_rasterize_char_utf32(render->font, U'o', render->subpixel);
+    int reserve = (render->conf->prompt_only ? 16 : 6) * (cell ? cell->advance.x : 10 * render->scale);
+    int measured = render->conf->hide_prompt ? 0 :
+        nostromo_text_width(render, render->conf->prompt, ceiling) + reserve;
+    struct application_list *apps = render->applications;
+    if (apps) {
+        mtx_lock(&apps->lock);
+        for (size_t i = 0; i < apps->count && measured < ceiling; i++) {
+            if (!apps->v[i]->visible) continue;
+            int label = nostromo_text_width(render, apps->v[i]->title, ceiling);
+            if (render->conf->icons_enabled) label += render->row_height + reserve / 6;
+            measured = max(measured, label);
+        }
+        mtx_unlock(&apps->lock);
+    }
+    int fixed = render->border_size * 2 + render->y_margin * 2 + render->message_height;
+    if (!render->conf->hide_prompt) fixed += render->row_height + render->inner_pad;
+    struct nostromo_panel_size size = nostromo_panel_dimensions(measured,
+        render->x_margin + render->border_size, fixed, render->row_height,
+        render->conf->lines, available_width, available_height, render->scale);
+    *width = size.width; *height = size.height;
+    return size.rows;
+}
